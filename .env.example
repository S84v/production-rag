APP_NAME=Production RAG
APP_VERSION=0.1.0
DEBUG=false

ALLOWED_COLLECTIONS=fastapi

# Comma-separated exact browser origins allowed cross-origin access, in the form
# scheme://host[:port] (no path, no trailing slash). Empty disables CORS.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional hosted PostgreSQL URL; takes precedence over POSTGRES_* below.
# Neon example (TLS is enforced by the asyncpg driver via ?sslmode=require):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

POSTGRES_USER=production_rag
POSTGRES_PASSWORD=production_rag_dev
POSTGRES_DB=production_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional hosted Qdrant endpoint; takes precedence over QDRANT_HOST/PORT.
# Qdrant Cloud example (never commit real endpoints or keys):
# QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
# QDRANT_API_KEY=YOUR_API_KEY

REDIS_HOST=localhost
REDIS_PORT=6379

DEEPSEEK_TIMEOUT=60

MAX_OUTPUT_TOKENS=1024
MAX_CONTEXT_CHARACTERS=12000

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_TRUST_CLOUD_RUN_X_FORWARDED_FOR=false
